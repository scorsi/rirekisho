---
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { formatPeriod, type Precision } from "../lib/dates";

interface Props {
  locale: Locale;
  title: string;
  org?: string;
  url?: string;
  location?: string;
  contract?: string;
  progression?: string;
  compact?: boolean;
  // Printed as a single line: title · company · location, no duration or text.
  printLine?: boolean;
  pdfSummary?: string;
  only?: "screen" | "print";
  start?: string;
  end?: string;
  precision?: Precision;
  summary?: string;
  highlights?: string[];
  tags?: string[];
  draft?: boolean;
}

const {
  locale,
  title,
  org,
  url,
  location,
  contract,
  progression,
  compact,
  printLine,
  pdfSummary,
  only,
  start,
  end,
  precision,
  summary,
  highlights = [],
  tags = [],
  draft,
} = Astro.props;
const t = useTranslations(locale);
const { range, duration } = formatPeriod(start, end, locale, precision);
---

{/* Dates above the title in print: next to the sidebar, a date column would leave the text too
    narrow. Compact entries keep their tighter padding at every width. */}
<article
  class:list={[
    "grid grid-cols-[185px_minmax(0,1fr)] gap-8 border-b border-dashed border-rule last:border-b-0",
    "narrow:grid-cols-1 narrow:gap-1.5",
    "print:break-inside-avoid print:grid-cols-[minmax(0,1fr)] print:gap-0 print:py-[5px]",
    compact ? "py-4" : "py-[22px] narrow:py-[18px]",
    {
      "print-line": printLine,
      "no-print": only === "screen",
      "hidden print:grid": only === "print",
    },
  ]}
>
  {/* The duration wraps under the dates in the narrow side column, never the dates themselves. */}
  <p
    class:list={[
      "flex flex-col font-mono text-[12.5px]/[1.7] tabular-nums",
      "narrow:flex-row narrow:gap-2.5 narrow:text-[12px]",
      "print:flex-row print:flex-wrap print:gap-x-2 print:text-[7.6pt]/[1.5]",
      { "text-muted": draft },
    ]}
  >
    <span class="print:whitespace-nowrap">{range || t("date.unknown")}</span>
    {duration && <span class="duration text-muted print:whitespace-nowrap">{duration}</span>}
  </p>
  <div class="what">
    <h3
      class:list={[
        "font-sans font-semibold tracking-[-0.005em] print:text-[10pt]",
        compact ? "text-[15px]/[1.35]" : "text-[17px]/[1.35]",
      ]}
    >
      {title}
      {draft && (
        <span class="ml-2.5 rounded-[3px] bg-shu-soft px-[7px] py-0.5 align-[3px] font-mono text-[10.5px]/[normal] font-medium text-shu">
          {t("draft")}
        </span>
      )}
    </h3>
    {(org || location || contract) && (
      <p class="org mt-0.5 text-muted">
        {[
          org &&
            (url ? (
              <a class="font-medium text-ink" href={url}>
                {org}
              </a>
            ) : (
              <span class="font-medium text-ink">{org}</span>
            )),
          location && <span>{location}</span>,
          contract && <span>{contract}</span>,
        ]
          .filter(Boolean)
          .map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              {part}
            </>
          ))}
      </p>
    )}
    {progression && (
      <p class="mt-1 font-mono text-[12px]/[1.5] text-muted print:mt-px print:text-[7.4pt]">
        {progression}
      </p>
    )}
    {summary && (
      <p
        class:list={[
          "summary max-w-[68ch] print:mt-[3px]",
          compact ? "mt-1" : "mt-2.5",
          { "no-print": pdfSummary },
        ]}
      >
        {summary}
      </p>
    )}
    {pdfSummary && (
      <p class="mt-2.5 hidden max-w-[68ch] print:mt-[3px] print:block">{pdfSummary}</p>
    )}
    {highlights.length > 0 && (
      <ul class:list={["highlights mt-2 print:mt-0.5", { "no-print": pdfSummary }]}>
        {highlights.map((h) => (
          <li class="relative mt-1 max-w-[68ch] pl-[18px] before:absolute before:left-0 before:text-shu before:content-['—'] print:mt-px">
            {h}
          </li>
        ))}
      </ul>
    )}
    {
      // The technologies are in the text and in the skills section; the PDF has no room to repeat them.
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5 print:hidden">
          {tags.map((tag) => (
            <li class="rounded-[3px] border border-rule px-[7px] py-px font-mono text-[11.5px]/[normal] text-muted before:text-shu before:content-['#']">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  @reference "../styles/global.css";

  /* One line: dates, then title · company · location. The detail stays in the online version. */
  @media print {
    .print-line {
      @apply py-[3px];
    }

    .print-line .duration,
    .print-line .summary,
    .print-line .highlights {
      @apply hidden;
    }

    .print-line .what {
      @apply flex flex-wrap items-baseline;
    }

    .print-line h3 {
      @apply text-[9.2pt] font-medium;
    }

    .print-line .org {
      @apply mt-0 before:mx-[0.35em] before:content-['·'];
    }
  }
</style>
