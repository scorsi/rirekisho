---
interface Props {
  n: number;
  title: string;
  class?: string;
}
const { n, title, class: className } = Astro.props;
---

<section class:list={["mt-13 print:mt-3", className]}>
  <h2 class="mb-2 flex items-baseline gap-3.5 border-b border-rule pb-3 font-serif text-[26px]/[1.2] font-medium print:mb-0 print:break-after-avoid print:pb-1 print:text-[14pt]">
    <span class="font-mono text-[12px]/[normal] font-medium text-shu print:text-[7.5pt]">
      {String(n).padStart(2, "0")}
    </span>
    {title}
  </h2>
  <slot />
</section>
