---
import { Image } from "astro:assets";
import QRCode from "qrcode";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import TimelineItem from "../../components/TimelineItem.astro";
import ThemeToggle from "../../components/ThemeToggle.svelte";
import photo from "../../assets/photo.webp";
import { locales, localeTags, type Locale } from "../../i18n/locales";
import { pick } from "../../i18n/localized";
import { useTranslations } from "../../i18n/ui";
import {
  getEducation,
  getExperience,
  getInterests,
  getLanguages,
  getProfile,
  getSkills,
} from "../../lib/content";
import { email, phone } from "../../lib/contact";
import { formatYears } from "../../lib/dates";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;

const profile = await getProfile();
const [experience, education, skills, languages, interests] = await Promise.all([
  getExperience(),
  getEducation(),
  getSkills(),
  getLanguages(),
  getInterests(),
]);
// The PDF folds the compact (oldest) positions into a single line, after the detailed ones.
const earlier = experience.filter(({ data }) => data.compact);

// The QR code only makes sense once the site has a public address (RIREKISHO_SITE).
const onlineUrl = Astro.site ? new URL(`${base}${locale}/`, Astro.site).href : undefined;
const qr = onlineUrl
  ? await QRCode.toString(onlineUrl, {
      type: "svg",
      margin: 0,
      errorCorrectionLevel: "M",
      color: { dark: "#1a1917", light: "#0000" },
    })
  : undefined;

const initials = profile.name
  .split(/\s+/)
  .map((part) => part[0])
  .join("");
const updated = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: "long" }).format(
  new Date(),
);
const handle =
  profile.links
    .find((l) => l.label === "GitHub")
    ?.url.split("/")
    .pop() ?? "me";
---

<Base
  locale={locale}
  title={t("meta.title", { name: profile.name })}
  description={pick(profile.headline, locale)}
>
  <nav class="bar no-print" aria-label="Options">
    <p class="prompt" aria-hidden="true">
      <b>{handle}</b>@<i>rirekisho</i>:~/{locale}$ cat cv<span class="cursor"></span>
    </p>
    <ul class="controls">
      {locales.map((l) => (
        <li>
          <a
            href={`${base}${l}/`}
            hreflang={l}
            aria-current={l === locale ? "page" : undefined}
            class:list={{ on: l === locale }}
          >
            {l.toUpperCase()}
          </a>
        </li>
      ))}
      <li>
        <ThemeToggle
          client:only="svelte"
          title={t("action.theme")}
          labels={{ system: t("theme.system"), light: t("theme.light"), dark: t("theme.dark") }}
        />
      </li>
      <li>
        <a class="pdf" href={`${base}rirekisho-${locale}.pdf`} download>
          {t("action.pdf")} ↓
        </a>
      </li>
    </ul>
  </nav>

  <main class="sheet">
    <p class="tate no-print" lang="ja" aria-hidden="true">
      履歴書・職務経歴
    </p>

    <header class="hero">
      <Image src={photo} alt="" width={240} height={240} class="photo" loading="eager" />
      <div class="identity">
        <h1>{profile.name}</h1>
        <p class="role">{pick(profile.headline, locale)}</p>
      </div>
      <div class="side">
        <p class="seal no-print" aria-hidden="true">
          {initials}
        </p>
        <ul class="contact">
          {email && (
            <li>
              <a href={email.href}>{email.display}</a>
            </li>
          )}
          {phone && (
            <li>
              <a href={phone.href}>{phone.display}</a>
            </li>
          )}
          <li class="muted">{pick(profile.location, locale)}</li>
          <li>
            {profile.links.map((link, i) => (
              <>
                {i > 0 && <span class="muted"> · </span>}
                <a href={link.url}>{link.label.toLowerCase()}</a>
              </>
            ))}
          </li>
        </ul>
      </div>
      {qr && onlineUrl && (
        <a class="qr print-only" href={onlineUrl}>
          <Fragment set:html={qr} />
          <span>{t("print.online")}</span>
        </a>
      )}
    </header>

    <p class="lead">{pick(profile.summary, locale)}</p>
    {profile.availability && <p class="availability">{pick(profile.availability, locale)}</p>}

    <div class="body">
      <div class="main">
        <Section n={1} title={t("section.experience")}>
          {experience.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.company}
              url={data.url}
              location={pick(data.location, locale)}
              contract={data.contract && t(`contract.${data.contract}`)}
              progression={data.roles
                .map((r) => `${pick(r.title, locale)} ${formatYears(r.start, r.end)}`)
                .join(" → ")}
              compact={data.compact}
              only={data.compact ? "screen" : undefined}
              pdfSummary={pick(data.pdf_summary, locale)}
              start={data.start}
              end={data.end}
              summary={pick(data.summary, locale)}
              highlights={data.highlights.map((h) => pick(h, locale))}
              tags={data.tags}
              draft={data.draft}
            />
          ))}
          {earlier.length > 0 && (
            <TimelineItem
              locale={locale}
              only="print"
              printLine
              title={earlier
                .map(({ data }) => {
                  const where = data.company ?? (data.contract && t(`contract.${data.contract}`));
                  return where
                    ? `${pick(data.title, locale)} (${where})`
                    : pick(data.title, locale);
                })
                .join(" · ")}
              start={earlier.map(({ data }) => data.start ?? "").sort()[0]}
              end={earlier
                .map(({ data }) => data.end ?? "")
                .sort()
                .at(-1)}
            />
          )}
        </Section>

        <Section n={2} title={t("section.education")} class="no-print">
          {education.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.school}
              url={data.url}
              location={pick(data.location, locale)}
              start={data.start}
              end={data.end}
              summary={pick(data.summary, locale)}
              draft={data.draft}
            />
          ))}
        </Section>
      </div>

      <div class="three">
        {/* The PDF puts education at the top of the side column, keeping the sections' numbering in
            reading order; on screen it stays under the experience. */}
        <Section n={2} title={t("section.education")} class="print-only">
          {education.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.school}
              url={data.url}
              location={pick(data.location, locale)}
              start={data.start}
              end={data.end}
              summary={pick(data.summary, locale)}
              draft={data.draft}
            />
          ))}
        </Section>

        <Section n={3} title={t("section.skills")}>
          <dl class="skills">
            {skills.map(({ data }) => (
              <div>
                <dt>{pick(data.label, locale)}</dt>
                <dd>
                  <ul class="chips">
                    {data.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </Section>

        <Section n={4} title={t("section.languages")}>
          <ul class="langs">
            {languages.map(({ data }) => (
              <li>
                <span>{pick(data.name, locale)}</span>
                <span class="level">{pick(data.level, locale)}</span>
              </li>
            ))}
          </ul>
        </Section>

        <Section n={5} title={t("section.interests")}>
          <ul class="interests">
            {interests.map(({ data }) => (
              <li>
                <b>{pick(data.title, locale)}</b>
                {data.description && <p class="muted">{pick(data.description, locale)}</p>}
                {data.link && (
                  <p class="link">
                    <a href={data.link.url}>{data.link.label}</a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </Section>
      </div>
    </div>

    <footer class="no-print">
      <span>built with astro · nix build</span>
      <span>{t("footer.updated", { date: updated })}</span>
    </footer>
  </main>
</Base>

<style>
  .bar {
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 24px;
    font: 12.5px var(--mono);
    color: var(--muted);
  }

  .prompt b {
    color: var(--ink);
    font-weight: 500;
  }

  .prompt i {
    color: var(--shu);
    font-style: normal;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.2em;
    background: var(--shu);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .controls a {
    text-decoration: none;
  }

  .controls .on {
    color: var(--ink);
  }

  .controls .on::before {
    content: "[";
    color: var(--shu);
  }

  .controls .on::after {
    content: "]";
    color: var(--shu);
  }

  .pdf {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    color: var(--ink);
  }

  .pdf:hover {
    border-color: var(--shu);
  }

  .sheet {
    position: relative;
    max-width: 1080px;
    margin: 0 auto 60px;
    padding: 64px 72px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .tate {
    position: absolute;
    right: 26px;
    top: 64px;
    writing-mode: vertical-rl;
    font: 500 13px/1 var(--jp);
    letter-spacing: 0.5em;
    color: var(--muted);
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 36px;
    align-items: end;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--ink);
  }

  .hero :global(.photo) {
    width: 120px;
    height: 150px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    border: 1px solid var(--rule);
  }

  h1 {
    font: 400 64px/1 var(--serif);
    letter-spacing: -0.02em;
  }

  .role {
    margin-top: 14px;
    font: 500 13px var(--mono);
    letter-spacing: 0.04em;
    color: var(--shu);
  }

  .role::before {
    content: "> ";
  }

  .side {
    text-align: right;
  }

  .seal {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    margin: 0 0 14px auto;
    border: 2.5px solid var(--shu);
    border-radius: 8px;
    font: 600 22px var(--serif);
    color: var(--shu);
    transform: rotate(-4deg);
    opacity: 0.9;
  }

  .contact {
    font: 12.5px/1.9 var(--mono);
  }

  .contact a {
    text-decoration: none;
  }

  .qr {
    width: 62px;
    text-align: center;
    font: 6.5pt var(--mono);
    color: var(--muted);
    text-decoration: none;
  }

  .qr :global(svg) {
    display: block;
    width: 62px;
    height: 62px;
    margin-bottom: 3px;
  }

  .lead {
    max-width: 46ch;
    margin: 40px 0 0;
    font: 400 22px/1.5 var(--serif);
  }

  .availability {
    margin-top: 12px;
    font: 500 13px var(--mono);
    color: var(--shu);
  }

  /* Layout wrappers for print only (a sidebar next to the experience); on screen they don't exist. */
  .body,
  .main {
    display: contents;
  }

  .three {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 48px;
    margin-top: 52px;
  }

  .three :global(section) {
    margin-top: 0;
  }

  .skills > div {
    margin-top: 14px;
  }

  dt {
    font: 500 11.5px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--shu);
  }

  dd {
    margin-top: 4px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .chips li {
    padding: 1px 7px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-size: 13px;
  }

  .langs li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--rule);
  }

  .level {
    font: 12.5px var(--mono);
    color: var(--muted);
    text-align: right;
  }

  .interests li {
    margin-top: 12px;
  }

  .interests b {
    font-weight: 600;
  }

  .interests p {
    font-size: 14px;
  }

  .interests .link {
    font: 12.5px var(--mono);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 56px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    font: 11.5px var(--mono);
    color: var(--muted);
  }

  @media screen and (max-width: 900px) {
    .sheet {
      padding: 48px 40px;
    }

    .tate {
      display: none;
    }

    .hero {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .side {
      grid-column: 1 / -1;
      text-align: left;
    }

    .seal {
      display: none;
    }

    h1 {
      font-size: 48px;
    }

    .three {
      grid-template-columns: 1fr 1fr;
    }

    .three :global(section:first-child) {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 600px) {
    .bar {
      padding: 14px 16px;
    }

    .sheet {
      padding: 32px 16px;
      border-left: 0;
      border-right: 0;
    }

    .hero {
      gap: 20px;
      padding-bottom: 28px;
    }

    .hero :global(.photo) {
      width: 80px;
      height: 100px;
    }

    h1 {
      font-size: 36px;
    }

    .role {
      margin-top: 8px;
    }

    .lead {
      font-size: 19px;
      margin-top: 28px;
    }

    .three {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 0;
    }

    .three :global(section) {
      margin-top: 44px;
    }
  }

  @media print {
    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .hero {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      gap: 18px;
      padding-bottom: 14px;
    }

    .hero :global(.photo) {
      width: 62px;
      height: 78px;
    }

    h1 {
      font-size: 30pt;
    }

    .role {
      margin-top: 6px;
      font-size: 8.5pt;
    }

    .contact {
      font-size: 7.8pt;
      line-height: 1.7;
    }

    .lead {
      max-width: none;
      margin-top: 10px;
      font-size: 11pt;
      line-height: 1.4;
    }

    /* Skills, languages and interests in a column next to the experience: the page reads as a
       classic two-column résumé and the experience keeps most of the width. */
    .body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 50mm;
      column-gap: 7mm;
      align-items: start;
    }

    .main {
      display: block;
    }

    .three {
      display: block;
      margin-top: 0;
    }

    /* Same spacing as the main column's sections, so both columns start on the same line. */
    .three :global(section) {
      margin-top: 12px;
    }

    .skills > div {
      margin-top: 4px;
    }

    dt {
      font-size: 7pt;
    }

    dd {
      margin-top: 2px;
    }

    .chips {
      gap: 3px;
    }

    .chips li {
      padding: 0 4px;
      font-size: 8pt;
    }

    .langs li {
      padding: 3px 0;
    }

    .level {
      font-size: 7.8pt;
    }

    /* Titles only, one per line: the descriptions stay in the online version. */
    .interests {
      margin-top: 2px;
    }

    .interests li {
      margin-top: 2px;
    }

    .interests b {
      font-weight: 500;
    }

    .interests p:not(.link) {
      display: none;
    }

    .interests .link {
      display: inline;
      margin-left: 0.3em;
      font-size: 7.8pt;
    }
  }
</style>
