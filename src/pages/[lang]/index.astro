---
import { Image } from "astro:assets";
import QRCode from "qrcode";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import TimelineItem from "../../components/TimelineItem.astro";
import ThemeToggle from "../../components/ThemeToggle.svelte";
import photo from "../../assets/photo.webp";
import { locales, localeTags, type Locale } from "../../i18n/locales";
import { pick } from "../../i18n/localized";
import { useTranslations } from "../../i18n/ui";
import {
  getEducation,
  getExperience,
  getInterests,
  getLanguages,
  getProfile,
  getSkills,
} from "../../lib/content";
import { email, phone } from "../../lib/contact";
import { formatYears } from "../../lib/dates";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;

const profile = await getProfile();
const [experience, education, skills, languages, interests] = await Promise.all([
  getExperience(),
  getEducation(),
  getSkills(),
  getLanguages(),
  getInterests(),
]);
// The PDF folds the compact (oldest) positions into one titled entry, after the detailed ones.
const earlier = experience.filter(({ data }) => data.compact);

// The QR code only makes sense once the site has a public address (RIREKISHO_SITE).
const onlineUrl = Astro.site ? new URL(`${base}${locale}/`, Astro.site).href : undefined;
const qr = onlineUrl
  ? await QRCode.toString(onlineUrl, {
      type: "svg",
      margin: 0,
      errorCorrectionLevel: "M",
      color: { dark: "#1a1917", light: "#0000" },
    })
  : undefined;

const initials = profile.name
  .split(/\s+/)
  .map((part) => part[0])
  .join("");
const updated = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: "long" }).format(
  new Date(),
);
const handle =
  profile.links
    .find((l) => l.label === "GitHub")
    ?.url.split("/")
    .pop() ?? "me";
---

<Base
  locale={locale}
  title={t("meta.title", { name: profile.name })}
  description={pick(profile.headline, locale)}
>
  <nav
    class="no-print mx-auto flex max-w-[1080px] flex-wrap items-center justify-between gap-x-6 gap-y-2.5 px-6 py-[18px] font-mono text-[12.5px]/[normal] text-muted phone:px-4 phone:py-3.5"
    aria-label="Options"
  >
    <p aria-hidden="true">
      <b class="font-medium text-ink">{handle}</b>@<i class="text-shu not-italic">rirekisho</i>:~/
      {locale}$ cat cv
      <span class="ml-1 inline-block h-[1.1em] w-[0.55em] animate-blink bg-shu align-[-0.2em] motion-reduce:animate-none"></span>
    </p>
    <ul class="flex items-center gap-4">
      {locales.map((l) => (
        <li>
          <a
            href={`${base}${l}/`}
            hreflang={l}
            aria-current={l === locale ? "page" : undefined}
            class:list={[
              "no-underline",
              l === locale &&
                "text-ink before:text-shu before:content-['['] after:text-shu after:content-[']']",
            ]}
          >
            {l.toUpperCase()}
          </a>
        </li>
      ))}
      <li>
        <ThemeToggle
          client:only="svelte"
          title={t("action.theme")}
          labels={{ system: t("theme.system"), light: t("theme.light"), dark: t("theme.dark") }}
        />
      </li>
      <li>
        <a
          class="inline-block rounded-[4px] border border-ink px-2.5 py-1 text-ink no-underline hover:border-shu"
          href={`${base}rirekisho-${locale}.pdf`}
          download
        >
          {t("action.pdf")} ↓
        </a>
      </li>
    </ul>
  </nav>

  <main class="relative mx-auto mb-[60px] max-w-[1080px] border border-rule bg-paper px-[72px] py-16 tablet:px-10 tablet:py-12 phone:border-x-0 phone:px-4 phone:py-8 print:m-0 print:max-w-none print:border-0 print:p-0">
    <p
      class="no-print absolute top-16 right-[26px] font-jp text-[13px]/none font-medium tracking-[0.5em] text-muted [writing-mode:vertical-rl] tablet:hidden"
      lang="ja"
      aria-hidden="true"
    >
      履歴書・職務経歴
    </p>

    <header class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-end gap-9 border-b border-ink pb-10 tablet:grid-cols-[auto_minmax(0,1fr)] phone:gap-5 phone:pb-7 print:grid-cols-[auto_minmax(0,1fr)_auto_auto] print:gap-[18px] print:pb-3.5">
      <Image
        src={photo}
        alt=""
        width={240}
        height={300}
        class="h-[150px] w-[120px] border border-rule object-cover contrast-[1.05] grayscale phone:h-[100px] phone:w-[80px] print:h-[78px] print:w-[62px]"
        loading="eager"
      />
      <div>
        <h1 class="font-serif text-[64px]/none font-normal tracking-[-0.02em] tablet:text-[48px] phone:text-[36px] print:text-[30pt]">
          {profile.name}
        </h1>
        <p class="mt-3.5 font-mono text-[13px]/[normal] font-medium tracking-[0.04em] text-shu before:content-['>_'] phone:mt-2 print:mt-1.5 print:text-[8.5pt]">
          {pick(profile.headline, locale)}
        </p>
      </div>
      <div class="text-right tablet:col-span-full tablet:text-left">
        <p
          class="no-print mb-3.5 ml-auto grid size-[62px] -rotate-4 place-items-center rounded-[8px] border-[2.5px] border-shu font-serif text-[22px]/[normal] font-semibold text-shu opacity-90 tablet:hidden"
          aria-hidden="true"
        >
          {initials}
        </p>
        <ul class="font-mono text-[12.5px]/[1.9] [&_a]:no-underline print:text-[7.8pt]/[1.7]">
          {email && (
            <li>
              <a href={email.href}>{email.display}</a>
            </li>
          )}
          {phone && (
            <li>
              <a href={phone.href}>{phone.display}</a>
            </li>
          )}
          <li class="text-muted">{pick(profile.location, locale)}</li>
          <li>
            {profile.links.map((link, i) => (
              <>
                {i > 0 && <span class="text-muted"> · </span>}
                <a href={link.url}>{link.label.toLowerCase()}</a>
              </>
            ))}
          </li>
        </ul>
      </div>
      {qr && onlineUrl && (
        <a
          class="print-only w-[62px] text-center font-mono text-[6.5pt]/[normal] text-muted no-underline [&_svg]:mb-[3px] [&_svg]:block [&_svg]:size-[62px]"
          href={onlineUrl}
        >
          <Fragment set:html={qr} />
          <span>{t("print.online")}</span>
        </a>
      )}
    </header>

    <p class="mt-10 max-w-[46ch] font-serif text-[22px]/[1.5] font-normal phone:mt-7 phone:text-[19px] print:mt-2.5 print:max-w-none print:text-[11pt]/[1.4]">
      {pick(profile.summary, locale)}
    </p>
    {profile.availability && (
      <p class="mt-3 font-mono text-[13px]/[normal] font-medium text-shu print:mt-1.5 print:text-[8.5pt]">
        {pick(profile.availability, locale)}
      </p>
    )}

    {/* Skills, languages and interests in a column next to the experience in print: the page reads
        as a classic two-column résumé. On screen these wrappers don't exist (display: contents). */}
    <div class="contents print:grid print:grid-cols-[minmax(0,1fr)_50mm] print:items-start print:gap-x-[7mm]">
      <div class="contents print:block">
        <Section n={1} title={t("section.experience")}>
          {experience.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.company}
              url={data.url}
              location={pick(data.location, locale)}
              contract={data.contract && t(`contract.${data.contract}`)}
              progression={data.roles
                .map((r) => `${pick(r.title, locale)} ${formatYears(r.start, r.end)}`)
                .join(" → ")}
              compact={data.compact}
              only={data.compact ? "screen" : undefined}
              pdfSummary={pick(data.pdf_summary, locale)}
              start={data.start}
              end={data.end}
              precision={data.precision}
              summary={pick(data.summary, locale)}
              highlights={data.highlights.map((h) => pick(h, locale))}
              tags={data.tags}
              draft={data.draft}
            />
          ))}
          {earlier.length > 0 && (
            <TimelineItem
              locale={locale}
              only="print"
              title={t("experience.earlier")}
              summary={earlier
                .map(({ data }) => {
                  const where = data.company ?? (data.contract && t(`contract.${data.contract}`));
                  return where
                    ? `${pick(data.title, locale)} (${where})`
                    : pick(data.title, locale);
                })
                .join(" · ")}
              start={earlier.map(({ data }) => data.start ?? "").sort()[0]}
              end={earlier
                .map(({ data }) => data.end ?? "")
                .sort()
                .at(-1)}
            />
          )}
        </Section>

        <Section n={2} title={t("section.education")} class="no-print">
          {education.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.school}
              url={data.url}
              location={pick(data.location, locale)}
              start={data.start}
              end={data.end}
              precision={data.precision}
              summary={pick(data.summary, locale)}
              draft={data.draft}
            />
          ))}
        </Section>
      </div>

      {/* Same spacing as the main column's sections in print, so both columns start on the same line. */}
      <div class="mt-13 grid grid-cols-[1.3fr_1fr_1fr] gap-12 *:mt-0 tablet:grid-cols-2 phone:mt-0 phone:grid-cols-1 phone:gap-0 phone:*:mt-11 print:mt-0 print:block print:*:mt-3">
        {/* The PDF puts education at the top of the side column, keeping the sections' numbering in
            reading order; on screen it stays under the experience. */}
        <Section n={2} title={t("section.education")} class="print-only">
          {education.map(({ data }) => (
            <TimelineItem
              locale={locale}
              title={pick(data.title, locale)}
              org={data.school}
              url={data.url}
              location={pick(data.location, locale)}
              start={data.start}
              end={data.end}
              precision={data.precision}
              summary={pick(data.summary, locale)}
              draft={data.draft}
            />
          ))}
        </Section>

        <Section n={3} title={t("section.skills")} class="tablet:col-span-full">
          <dl class="*:mt-3.5 print:*:mt-1">
            {skills.map(({ data }) => (
              <div>
                <dt class="font-mono text-[11.5px]/[normal] font-medium tracking-[0.08em] text-shu uppercase print:text-[7pt]">
                  {pick(data.label, locale)}
                </dt>
                <dd class="mt-1 print:mt-0.5">
                  <ul class="flex flex-wrap gap-[5px] print:gap-[3px]">
                    {data.items.map((item) => (
                      <li class="rounded-[3px] border border-rule px-[7px] py-px text-[13px] print:px-1 print:py-0 print:text-[8pt]">
                        {item}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </Section>

        <Section n={4} title={t("section.languages")}>
          <ul>
            {languages.map(({ data }) => (
              <li class="flex justify-between gap-3 border-b border-dashed border-rule py-[7px] print:py-[3px]">
                <span>{pick(data.name, locale)}</span>
                <span class="text-right font-mono text-[12.5px]/[normal] text-muted print:text-[7.8pt]">
                  {pick(data.level, locale)}
                </span>
              </li>
            ))}
          </ul>
        </Section>

        <Section n={5} title={t("section.interests")}>
          {/* Titles only in print, one per line: the descriptions stay in the online version. */}
          <ul class="print:mt-0.5">
            {interests.map(({ data }) => (
              <li class="mt-3 print:mt-0.5">
                <b class="font-semibold print:font-medium">{pick(data.title, locale)}</b>
                {data.description && (
                  <p class="text-[14px] text-muted print:hidden">
                    {pick(data.description, locale)}
                  </p>
                )}
                {data.link && (
                  <p class="font-mono text-[12.5px]/[normal] print:ml-[0.3em] print:inline print:text-[7.8pt]">
                    <a href={data.link.url}>{data.link.label}</a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </Section>
      </div>
    </div>

    <footer class="no-print mt-14 flex flex-wrap justify-between gap-2 border-t border-ink pt-4 font-mono text-[11.5px]/[normal] text-muted">
      <span>built with astro · nix build</span>
      <span>{t("footer.updated", { date: updated })}</span>
    </footer>
  </main>
</Base>
