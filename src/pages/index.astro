---
import { defaultLocale, locales } from "../i18n/locales";

// A static site has no Accept-Language: pick the browser's language client-side, with a plain
// redirect to the default locale when scripts are off.
const base = import.meta.env.BASE_URL;
const target = `${base}${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <title>Sylvain Corsini</title>
    <script is:inline define:vars={{ base, locales, target }}>
      const wanted = (navigator.languages || [navigator.language])
        .map((l) => l.slice(0, 2).toLowerCase())
        .find((l) => locales.includes(l));
      location.replace(wanted ? `${base}${wanted}/` : target);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${target}`} />
    </noscript>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <a href={target}>{target}</a>
  </body>
</html>
