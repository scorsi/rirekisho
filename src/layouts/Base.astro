---
import "../styles/global.css";
import { locales, localeTags, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const alternates = Astro.site
  ? locales.map((l) => ({ l, href: new URL(`${base}${l}/`, Astro.site).href }))
  : [];
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {alternates.map(({ l, href }) => (
      <link rel="alternate" hreflang={localeTags[l]} href={href} />
    ))}
    <!-- Applied before first paint, so a stored theme never flashes the other one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
